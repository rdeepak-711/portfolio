# Dee (portfolio guide) environment. Copy to .env.local or .env and fill in.
# Every variable is optional. Missing ones switch features off, they never crash:
#   no model keys       -> Dee answers from the FAQ only
#   no Upstash          -> counters and spend live in memory (fine locally, NOT on Vercel)
#   no Resend/Telegram  -> Ask Deepak still saves, delivered: false for that channel
# Never commit the filled-in file. .gitignore already covers .env*.

# --- Primary model: Anthropic, claude-haiku-5-5 ---------------------------
# console.anthropic.com -> Settings -> API keys. Spend is capped at $5/day
# (DAILY_CAP_USD in src/lib/dee/budget.ts); past the cap Dee uses OpenRouter.
ANTHROPIC_API_KEY=

# --- Fallback model: OpenRouter (used after the $5/day cap, or if Anthropic fails)
# openrouter.ai -> Keys. Pick a free model id from openrouter.ai/models?max_price=0
# (ids ending in ":free"). Both values are needed for the fallback to switch on.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Shared store: Upstash Redis (REST) -----------------------------------
# Holds rate limits (60/IP/day, 20 msgs/session, 3 asks/IP/day), today's spend,
# and saved Ask Deepak questions (list "dee:asks").
# console.upstash.com -> create Redis DB -> "REST API" tab, or Vercel
# Marketplace -> Upstash (fills these in on the Vercel project for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Ask Deepak email: Resend ----------------------------------------------
# resend.com -> API Keys. Emails go to deepakrameshh@gmail.com.
# RESEND_FROM must be on a domain verified in Resend (e.g. Dee <dee@outbuiltit.com>).
# Left empty it uses Dee <onboarding@resend.dev>, which Resend only delivers to
# the address that owns the Resend account.
RESEND_API_KEY=
RESEND_FROM=

# --- Ask Deepak ping: Telegram bot @deepak_port_bot ------------------------
# Token: Telegram -> @BotFather -> /mybots -> @deepak_port_bot -> API Token.
# Chat ID: send any message to @deepak_port_bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy result[0].message.chat.id (a number).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
